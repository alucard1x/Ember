# Reference list of the variables this app reads. Copy the KEYS into Render's
# Environment tab and set the real values there.
#
# NOTE: this file is a template only. Nothing loads a .env automatically —
# db.php reads getenv() directly, so a .env file on disk has no effect.
# Locally you can leave everything unset; db.php falls back to XAMPP defaults.

DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASS=your-password-here
DB_NAME=defaultdb
DB_SSL=true

# Optional: path to the provider's CA certificate inside the container.
# Leave unset to connect over TLS without certificate verification.
# DB_SSL_CA=/var/www/html/ca.pem

# Public URL of the deployed site, used for links inside generated PDFs.
APP_URL=https://ember-restaurant.onrender.com
