# OS cruft
.DS_Store
**/.DS_Store
Thumbs.db

# Secrets — never commit real credentials.
# .env.example is committed as a template; .env is not.
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Local setup state
setup_completed.flag

# Editor
.vscode/
.idea/

# Local helper scripts and leftovers (never part of the site)
_tools/
.fuse_hidden*

# Login details for the demo accounts - kept on your computer only
docs/ember-login-credentials.pdf

# Course documents (reports, slides, diagrams) - kept on your computer, not in the repo
docs/
